{
	"layer": "top",
	"position": "top",
	"height": 30,
	"spacing": 4,
	"modules-left": [
    "custom/terminal",
    "custom/launcher",
		"hyprland/workspaces"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
    // "bluetooth",
		"network",
		"pulseaudio",
		"backlight",
		"battery",
		"power-profiles-daemon",
		"idle_inhibitor",
		"tray",
		"clock",
    "custom/logout"
	],
	"backlight": {
    "device": "amdgpu_bl2",
	  "format": "{percent}% {icon}",
	  "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "reverse-scrolling": true,
    "smooth-scrolling-threshold": 1
	},
	"battery": {
		"states": {
	    // "good": 95,
	    "warning": 30,
	    "critical": 15
		},
		"format": "{capacity}% {icon}",
		"format-full": "{capacity}% {icon}",
		"format-charging": "{capacity}% ",
		"format-plugged": "{capacity}% ",
		"format-alt": "{time} {icon}",
	  // "format-good": "", // An empty format will hide the module
	  // "format-full": "",
	  "format-icons": ["", "", "", "", ""]
	},
  "bluetooth": {
	  "format": "󰂯",
	  "format-off": "󰂲"
  },
	"clock": {
	  // "timezone": "America/New_York",
    "format": "{:%A - %H:%M}",
	  "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	  "format-alt": "{:%Y-%m-%d}"
	},
  "custom/terminal": {
    "format": " ",
    "tooltip-format": "Terminal",
    "on-click": "kitty"
  },
  "custom/launcher": {
    "format": " ",
    "tooltip-format": "App Launcher",
    "on-click": "rofi -show drun"
  },
  "custom/logout": {
    "format": "󰐥 ",
    "tooltip-format": "Logout",
    "on-click": "wlogout"
  },
	"cpu": {
		"format": "{usage}% ",
		"tooltip": false
	},
	"hyprland/workspaces": {
		"active-only": false,
		"persistent-workspaces": {
    },
		"disable-scroll": false,
		"all-outputs": true,
		"warp-on-scroll": true,
		"format": "{name}",
		"format-icons": {
	   		 "urgent": "",
	   		 "focused": "",
	   		 "default": ""
		},
    "on-click": "activate"
	},
	"hyprland/window": {
		// "max-length": 30,
		"max-length": 50,
		"separate-outputs": true
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		}
	},
	"memory": {
		"format": "{}% "
	},
	"network": {
		// "format-wifi": "{essid}: {signalStrength} ",
		"format-wifi": "{bandwidthUpBits}  | {bandwidthDownBits} ",
		// "tooltip-format-wifi": "{bandwidthUpBits}  | {bandwidthDownBits}  \n{gwaddr} - {ipaddr}",
		"tooltip-format-wifi": "{gwaddr} - {ipaddr}",
		"tooltip-format-ethernet": "{ifname} {gwaddr} - {ipaddr} ",
		"format-linked": "{ifname} (No IP) ",
		"format-disconnected": "󰈂"
		//  "format-alt": "{bandwidthUpBits}  | {bandwidthDownBits} "
		// "format-wifi": "({signalStrength}%) ",
		// "format-ethernet": " {bandwidthDownBytes} - ",
		// "tooltip-format-wifi": "{essid} {gwaddr} - {ipaddr} ",
	},
	"power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
	"pulseaudio": {
	  "format": "{volume}% {icon}",
	  "format-bluetooth": "{volume}% {icon} {format_source}",
	  "format-bluetooth-muted": " {icon} {format_source}",
	  "format-muted": " {format_source}",
	  // "format-source": "{volume}% ",
	  // "format-source-muted": "",
	  "format-icons": {
	  	"headphone": "",
	  	"hands-free": "",
	  	"headset": "",
	  	"phone": "",
	  	"portable": "",
	  	"car": "",
	  	"default": ["", "", ""]
	  },
    "reverse-scrolling": true,
    "smooth-scrolling-threshold": 1,
	  "on-click": "pavucontrol"
	},
	"tray": {
	// "icon-size": 21,
	"spacing": 10
	}
}
